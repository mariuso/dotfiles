[user]
	email = 2239962+mariuso@users.noreply.github.com
	name = Mariuso

[alias]
	# Commit shortcuts
	ac = commit -am
	c = commit
	ca = commit --amend
	can = commit --amend --no-edit
	
	# Status and logs
	s = status --short
	st = status
	l = log --oneline --graph --decorate
	ll = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	
	# Branch management
	b = branch
	ba = branch -a
	bd = branch -d
	bD = branch -D
	
	# Checkout shortcuts
	co = checkout
	cb = checkout -b
	cm = checkout main
	cd = checkout develop
	
	# Remote operations
	f = fetch
	p = push
	pl = pull
	pom = push origin main
	pod = push origin develop
	
	# Stash operations
	ss = stash save
	sl = stash list
	sp = stash pop
	sd = stash drop
	
	# Diff shortcuts
	d = diff
	dc = diff --cached
	ds = diff --stat
	
	# Reset operations
	unstage = reset HEAD --
	undo = reset --soft HEAD^
	hard-reset = reset --hard HEAD
	
	# Misc utilities
	aliases = config --get-regexp alias
	ignore = "!gi() { curl -sL https://www.toptal.com/developers/gitignore/api/$@ ;}; gi"
	
[init]
	defaultBranch = main

[core]
	editor = nvim
	autocrlf = input
	excludesfile = ~/.gitignore

[pull]
	rebase = false

[push]
	default = simple
	autoSetupRemote = true

[merge]
	tool = vscode
	conflictstyle = diff3

[mergetool "vscode"]
	cmd = code --wait $MERGED

[diff]
	tool = vscode

[difftool "vscode"]
	cmd = code --wait --diff $LOCAL $REMOTE

[color]
	ui = auto
	branch = auto
	diff = auto
	status = auto

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold

[color "status"]
	added = yellow
	changed = green
	untracked = cyan

[fetch]
	prune = true

[log]
	decorate = short
